PROJECT_NAME=AegisOps
API_V1_STR=/api/v1
VERSION=0.1.0

# Step 3 activates this connection through Docker Compose and Alembic.
DATABASE_URL=postgresql+asyncpg://aegisops:aegisops@localhost:5432/aegisops

POSTGRES_USER=aegisops
POSTGRES_PASSWORD=aegisops
POSTGRES_DB=aegisops

MINIO_ROOT_USER=aegisops
MINIO_ROOT_PASSWORD=aegisops-dev-secret

NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-development-password
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=5.0

# Retains deterministic historical integration fixtures in local and CI infrastructure.
VICTORIAMETRICS_RETENTION_PERIOD=100y

# Change before deployment. Never commit the real value.
SECRET_KEY=change-this-development-secret-before-deployment

BACKEND_CORS_ORIGINS=["http://localhost:3000"]
